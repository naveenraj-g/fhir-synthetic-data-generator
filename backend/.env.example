# True per-environment secrets/URLs only — checked-in behavior config lives in
# configs/config.yaml, configs/cache.yaml and configs/synthetic_data_connectors.yaml.

# Optional. Defaults to a local SQLite file (backend/data/app.db). For Postgres:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app

# Optional overrides (relative paths resolve against backend/):
# CONNECTORS_CONFIG_PATH=configs/synthetic_data_connectors.yaml
# ARTIFACTS_DIR=data/artifacts

# Referenced from synthetic_data_connectors.yaml via ${VAR} (e.g. a FHIR server sink, Phase 4):
# FHIR_TARGET_URL=
# FHIR_TARGET_TOKEN=

# Redis — only if redis.enabled is true in configs/config.yaml.
# REDIS_URL=redis://localhost:6379

# Auth (optional) — see app/auth/dependencies.py.
# JWKS_URL=https://your-idp.example.com/.well-known/jwks.json
# JWT_ISSUER=https://your-idp.example.com
